# ================================================================
# MOBILE ROBOTS - TurtleBot3 Waffle x8  (ENU coordinate system)
#
# ENU robot body conventions:
#   translation x y z   -> x=east, y=north, z=up
#   rotation axis angle  -> rotate around z-axis for heading
#   Wheels spin around the y-axis (left/right), offset in y
#   z=0.033 puts wheel contact on ground
# ================================================================

# Robot 1 - Blue
DEF ROBOT_1 Robot {
  translation -4.0 3.0 0.033
  rotation 0 0 1 0
  name "robot_1"
  controller "robot_controller"
  customData "robot_id:1"
  children [
    # Chassis lower plate
    Pose {
      translation -0.064 0 0.01
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.2 0.2 0.8  roughness 0.8  metalness 0.3 }
          geometry Box { size 0.266 0.266 0.020 }
        }
      ]
    }
    # Chassis upper plate
    Pose {
      translation -0.064 0 0.057
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.2 0.2 0.8  roughness 0.8  metalness 0.3 }
          geometry Box { size 0.266 0.266 0.010 }
        }
      ]
    }
    # LiDAR housing
    Pose {
      translation -0.064 0 0.079
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.0 0.0 0.0 }
          geometry Cylinder { height 0.030  radius 0.028 }
        }
      ]
    }
    # --- Sensors ---
    Lidar {
      translation -0.064 0 0.097
      name "lidar"
      horizontalResolution 360
      fieldOfView 6.2832
      numberOfLayers 1
      maxRange 3.5
      minRange 0.12
    }
    GPS {
      translation 0 0 0.045
      name "gps"
    }
    Compass {
      translation 0 0 0.045
      name "compass"
    }
    InertialUnit {
      translation 0 0 0.045
      name "imu"
    }
    Emitter {
      name "emitter"
      channel 1
      range 100
    }
    Receiver {
      name "receiver"
      channel 1
    }
    # --- Left Wheel (positive y side) ---
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0.144 0
      }
      device [
        RotationalMotor {
          name "left_wheel_motor"
          maxVelocity 26.0
          maxTorque 1.8
        }
        PositionSensor {
          name "left_wheel_sensor"
        }
      ]
      endPoint Solid {
        translation 0 0.144 0
        rotation 1 0 0 1.5708
        children [
          Shape {
            appearance PBRAppearance { baseColor 0.1 0.1 0.1 }
            geometry Cylinder { height 0.018  radius 0.033 }
          }
        ]
        name "left_wheel"
        contactMaterial "wheel"
        boundingObject Cylinder { height 0.018  radius 0.033 }
        physics Physics { density -1  mass 0.1 }
      }
    }
    # --- Right Wheel (negative y side) ---
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 -0.144 0
      }
      device [
        RotationalMotor {
          name "right_wheel_motor"
          maxVelocity 26.0
          maxTorque 1.8
        }
        PositionSensor {
          name "right_wheel_sensor"
        }
      ]
      endPoint Solid {
        translation 0 -0.144 0
        rotation 1 0 0 1.5708
        children [
          Shape {
            appearance PBRAppearance { baseColor 0.1 0.1 0.1 }
            geometry Cylinder { height 0.018  radius 0.033 }
          }
        ]
        name "right_wheel"
        contactMaterial "wheel"
        boundingObject Cylinder { height 0.018  radius 0.033 }
        physics Physics { density -1  mass 0.1 }
      }
    }
    # --- Caster ball ---
    Solid {
      translation -0.177 0 -0.028
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.3 0.3 0.3 }
          geometry Sphere { radius 0.005 }
        }
      ]
      name "caster"
