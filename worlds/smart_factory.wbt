# ================================================================
# SUPERVISOR - Central controller (invisible, no physical body)
# ================================================================
DEF SUPERVISOR Robot {
  translation 0 0 0.5
  name "factory_supervisor"
  controller "factory_supervisor"
  controllerArgs [
    "C"
  ]
  supervisor TRUE
  children [
    Emitter {
      name "supervisor_emitter"
      channel 1
      range 100
    }
    Receiver {
      name "supervisor_receiver"
      channel 1
    }
  ]
}
