# ================================================================
# CHARGING STATIONS - 2 stations at factory left/right edges
# ENU: x=left/right position, y=0 center, z=up
# ================================================================
# CS1 — Ground induction charging pad (NO boundingObject, robots drive over).
# 1m × 1m × 5mm thin pad with strong green emissive color (visible in sim).
DEF CS1 Solid {
  translation -8.5 0 0.0025
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.8 0.1
        roughness 0.4
        metalness 0.2
        emissiveColor 0.2 0.7 0.2
        emissiveIntensity 1.5
      }
      geometry Box { size 1.0 1.0 0.005 }
    }
  ]
  name "charging_station_1"
  # NO boundingObject — robot drives on top of the pad
}
# Inner ring marker (darker, indicates the precise centre)
Solid {
  translation -8.5 0 0.003
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.05 0.4 0.05
        emissiveColor 0.1 0.5 0.1
      }
      geometry Cylinder { height 0.001  radius 0.18 }
    }
  ]
  name "cs1_centre_marker"
}
# Status LED — small green sphere, off the floor (no collision)
Solid {
  translation -8.9 0.45 0.05
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.0 1.0 0.0
        emissiveColor 0.0 0.9 0.0
        emissiveIntensity 2.0
      }
      geometry Sphere { radius 0.04 }
    }
  ]
  name "cs1_led"
}

# CS2 — Ground induction charging pad (mirror of CS1)
DEF CS2 Solid {
  translation 8.5 0 0.0025
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.8 0.1
        roughness 0.4
        metalness 0.2
        emissiveColor 0.2 0.7 0.2
        emissiveIntensity 1.5
      }
      geometry Box { size 1.0 1.0 0.005 }
    }
  ]
  name "charging_station_2"
  # NO boundingObject — robot drives on top of the pad
}
Solid {
  translation 8.5 0 0.003
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.05 0.4 0.05
        emissiveColor 0.1 0.5 0.1
      }
      geometry Cylinder { height 0.001  radius 0.18 }
    }
  ]
  name "cs2_centre_marker"
}
Solid {
  translation 8.9 0.45 0.05
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.0 1.0 0.0
        emissiveColor 0.0 0.9 0.0
        emissiveIntensity 2.0
      }
      geometry Sphere { radius 0.04 }
    }
  ]
  name "cs2_led"
}

