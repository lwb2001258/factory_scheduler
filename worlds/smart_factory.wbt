#VRML_SIM R2023b utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/floors/protos/RectangleArena.proto"

WorldInfo {
  info [
    "Smart Factory Multi-Robot Coordination Simulation"
    "Learning-Based Scheduling and Motion Coordination"
  ]
  title "Smart Factory - Multi-Robot Coordination"
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      material1 "wheel"
      material2 "floor"
      coulombFriction [1.0]
      softCFM 0.0001
    }
  ]
}

# ENU default: x=east, y=north, z=up
# Top-down camera looking at the factory from above
Viewpoint {
  orientation -0.577 0.577 0.577 2.094
  position 0 -2 22
  near 0.5
}

TexturedBackground {
  texture "factory"
}

TexturedBackgroundLight {
  texture "factory"
  luminosity 1.2
}

# ==================== FACTORY FLOOR (20m x 16m) ====================
RectangleArena {
  name "factory_floor"
  floorSize 20 16
  floorTileSize 1 1
  floorAppearance PBRAppearance {
    baseColor 0.85 0.85 0.82
    roughness 0.7
    metalness 0.0
  }
  wallHeight 0.5
  wallThickness 0.05
  wallAppearance PBRAppearance {
    baseColor 0.6 0.6 0.6
    roughness 0.5
    metalness 0.3
  }
}

# ================================================================
# WORKSTATIONS - 6 total on two parallel production lines
# ENU: translation x y z  -> x=east/west, y=north/south, z=up
# Line A (north): WS1, WS2, WS3 at y=+5
# Line B (south): WS4, WS5, WS6 at y=-5
# ================================================================

# ---------- Workstation 1 (Line A, Left) ----------
DEF WS1 Solid {
  translation -6 5 0.4
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.4 0.7
        roughness 0.5
        metalness 0.4
      }
      geometry Box {
        size 2.0 1.5 0.8
      }
    }
  ]
  name "WS1"
  boundingObject Box {
    size 2.0 1.5 0.8
  }
}
